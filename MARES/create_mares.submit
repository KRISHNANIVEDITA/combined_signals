######################## SUBMIT ########################

# Arguments passed to the bash script
Arguments = \
    $(NAME) \
    $(LISTFILE) \
    $(COREAS_DIR) \
    $(ENERGY) \
    $(ZENITH) \
    $(AZIMUTH) \
    $(CORE_COREAS) \
    $(OUTPUT_DIR)

queue

