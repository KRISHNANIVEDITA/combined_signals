# Executable: your bash script
executable = create_mares.sh

# any requirements: 
requirements = 

universe       = vanilla
getenv         = false
notification   = never
request_memory = 8000

# Log files
error  = /path/to/$(LOG_NAME).err
output = /path/to/$(LOG_NAME).out

######################## SUBMIT ########################

# Arguments passed to the bash script
Arguments = \
    $(NAME) \
    $(LISTFILE) \
    $(COREAS_DIR) \
    $(ENERGY) \
    $(ZENITH) \
    $(AZIMUTH) \
    $(CORE_COREAS) \
    $(OUTPUT_DIR)

queue

